{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@atc/schema": ["packages/schema/src/index.ts"],
      "@atc/runtime-core": ["packages/runtime-core/src/index.ts"],
      "@atc/animation-runtime": ["packages/animation-runtime/src/index.ts"],
      "@atc/animation-asset-runtime": ["packages/animation-asset-runtime/src/index.ts"],
      "@atc/input-runtime": ["packages/input-runtime/src/index.ts"],
      "@atc/terrain-runtime": ["packages/terrain-runtime/src/index.ts"],
      "@atc/haptics-runtime": ["packages/haptics-runtime/src/index.ts"],
      "@atc/replay-runtime": ["packages/replay-runtime/src/index.ts"],
      "@atc/world-runtime": ["packages/world-runtime/src/index.ts"],
      "@atc/character-control-runtime": ["packages/character-control-runtime/src/index.ts"],
      "@atc/scene-runtime": ["packages/scene-runtime/src/index.ts"],
      "@atc/capability-runtime": ["packages/capability-runtime/src/index.ts"],
      "@atc/editor-core": ["packages/editor-core/src/index.ts"],
      "@atc/git-adapter": ["packages/git-adapter/src/index.ts"],
      "@atc/ai-adapter": ["packages/ai-adapter/src/index.ts"],
      "@atc/acquisition-core": ["packages/acquisition-core/src/index.ts"],
      "@atc/unity-export": ["packages/unity-export/src/index.ts"],
      "@atc/repository-transaction": ["packages/repository-transaction/src/index.ts"]
    }
  }
}
