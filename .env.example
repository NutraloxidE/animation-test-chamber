# Animation Test Chamber — environment
#
# Every value here is OPTIONAL. With an empty .env the app boots fully:
#   - Git operations use the Fake Git Adapter (writes to .chamber-fake-git/)
#   - AI tuning uses the deterministic rule-based fallback provider
#   - Animation conversion (FBX/BVH) is reported as a Pending Job
#
# Never put any of these values in the web app. They are read by apps/api only.

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_PORT=8787

# ---------------------------------------------------------------------------
# Git integration (optional). Without these, GIT_ADAPTER falls back to "fake".
# ---------------------------------------------------------------------------
# fake | github
GIT_ADAPTER=fake
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
# Direct commits to this branch are always refused.
GITHUB_PROTECTED_BRANCH=main

# ---------------------------------------------------------------------------
# AI adjustment provider (optional). Without a key the rule-based provider runs.
# ---------------------------------------------------------------------------
# rule-based | anthropic
AI_PROVIDER=rule-based
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Animation worker (optional). Without it, FBX/BVH imports become Pending Jobs.
# ---------------------------------------------------------------------------
ANIMATION_WORKER_URL=
