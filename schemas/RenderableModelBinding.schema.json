{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "RenderableModelBinding",
  "anyOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "presetId"
      ],
      "properties": {
        "kind": {
          "const": "procedural-humanoid",
          "type": "string"
        },
        "presetId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "assetPath",
        "scale",
        "rotationYRad"
      ],
      "properties": {
        "kind": {
          "const": "repository-model",
          "type": "string"
        },
        "assetPath": {
          "minLength": 1,
          "type": "string"
        },
        "scale": {
          "minimum": 0.001,
          "maximum": 1000,
          "type": "number"
        },
        "rotationYRad": {
          "minimum": -6.283185307179586,
          "maximum": 6.283185307179586,
          "type": "number"
        }
      }
    }
  ]
}
