{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ReplayDefinition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "label",
    "revisionId",
    "fixedTimestepVersion",
    "seed",
    "terrainPresetId",
    "initialPosition",
    "initialYawRad",
    "cameraYawRad",
    "tickCount",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "revisionId": {
      "type": "string"
    },
    "fixedTimestepVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    },
    "terrainPresetId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "initialPosition": {
      "$id": "Vec3",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "initialYawRad": {
      "type": "number"
    },
    "cameraYawRad": {
      "type": "number"
    },
    "tickCount": {
      "minimum": 1,
      "maximum": 100000,
      "type": "integer"
    },
    "frames": {
      "type": "array",
      "items": {
        "$id": "ReplayFrame",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tick",
          "moveX",
          "moveY",
          "lookX",
          "lookY",
          "buttons"
        ],
        "properties": {
          "tick": {
            "minimum": 0,
            "type": "integer"
          },
          "moveX": {
            "minimum": -1,
            "maximum": 1,
            "type": "number"
          },
          "moveY": {
            "minimum": -1,
            "maximum": 1,
            "type": "number"
          },
          "lookX": {
            "minimum": -1,
            "maximum": 1,
            "type": "number"
          },
          "lookY": {
            "minimum": -1,
            "maximum": 1,
            "type": "number"
          },
          "buttons": {
            "minimum": 0,
            "type": "integer"
          }
        }
      }
    }
  }
}
