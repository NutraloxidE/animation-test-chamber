{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AssetReference",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "assetType",
    "assetId",
    "version",
    "contentHash"
  ],
  "properties": {
    "assetType": {
      "$id": "AnimationAssetType",
      "anyOf": [
        {
          "const": "animation-behavior",
          "type": "string"
        },
        {
          "const": "animation-motion-set",
          "type": "string"
        },
        {
          "const": "animation-clip",
          "type": "string"
        },
        {
          "const": "humanoid-rig",
          "type": "string"
        },
        {
          "const": "animation-tuning",
          "type": "string"
        }
      ]
    },
    "assetId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "contentHash": {
      "pattern": "^([a-f0-9]{64})?$",
      "type": "string"
    }
  }
}
