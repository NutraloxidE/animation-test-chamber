{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SaveAnimationChangesRequest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "characterId",
    "graph",
    "clips",
    "expected"
  ],
  "properties": {
    "characterId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "graph": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "patches",
        "destination"
      ],
      "properties": {
        "patches": {
          "type": "array",
          "items": {
            "$id": "CanonicalPatch",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "path",
              "op"
            ],
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "op": {
                "anyOf": [
                  {
                    "const": "set",
                    "type": "string"
                  },
                  {
                    "const": "append",
                    "type": "string"
                  },
                  {
                    "const": "remove",
                    "type": "string"
                  }
                ]
              },
              "value": {},
              "reason": {
                "type": "string"
              },
              "provenance": {
                "$id": "ValueProvenance",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "anyOf": [
                      {
                        "const": "repository",
                        "type": "string"
                      },
                      {
                        "const": "human-adjustment",
                        "type": "string"
                      },
                      {
                        "const": "ai-proposal",
                        "type": "string"
                      },
                      {
                        "const": "import",
                        "type": "string"
                      },
                      {
                        "const": "default",
                        "type": "string"
                      }
                    ]
                  },
                  "basedOnAiProposal": {
                    "type": "number"
                  },
                  "humanFinal": {
                    "type": "number"
                  },
                  "replayId": {
                    "type": "string"
                  },
                  "terrainPresetId": {
                    "type": "string"
                  },
                  "intent": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "destination": {
          "$id": "GraphChangeDestination",
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "character-override",
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "tuning-profile",
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "existing-behavior-variant",
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "newAssetId",
                "displayName"
              ],
              "properties": {
                "kind": {
                  "const": "new-behavior-variant",
                  "type": "string"
                },
                "newAssetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "displayName": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "shared-behavior",
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "none",
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "clips": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "changes",
        "destination"
      ],
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "$id": "ClipChange",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "sourceClip",
              "clipId",
              "patches"
            ],
            "properties": {
              "sourceClip": {
                "$id": "AssetReference",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "assetType",
                  "assetId",
                  "version",
                  "contentHash"
                ],
                "properties": {
                  "assetType": {
                    "$id": "AnimationAssetType",
                    "anyOf": [
                      {
                        "const": "animation-behavior",
                        "type": "string"
                      },
                      {
                        "const": "animation-motion-set",
                        "type": "string"
                      },
                      {
                        "const": "animation-clip",
                        "type": "string"
                      },
                      {
                        "const": "humanoid-rig",
                        "type": "string"
                      },
                      {
                        "const": "animation-tuning",
                        "type": "string"
                      }
                    ]
                  },
                  "assetId": {
                    "pattern": "^[a-z0-9][a-z0-9-]*$",
                    "minLength": 1,
                    "maxLength": 96,
                    "type": "string"
                  },
                  "version": {
                    "pattern": "^\\d+\\.\\d+\\.\\d+$",
                    "type": "string"
                  },
                  "contentHash": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  }
                }
              },
              "clipId": {
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "minLength": 1,
                "maxLength": 96,
                "type": "string"
              },
              "patches": {
                "type": "array",
                "items": {
                  "$id": "CanonicalPatch",
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "path",
                    "op"
                  ],
                  "properties": {
                    "path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "op": {
                      "anyOf": [
                        {
                          "const": "set",
                          "type": "string"
                        },
                        {
                          "const": "append",
                          "type": "string"
                        },
                        {
                          "const": "remove",
                          "type": "string"
                        }
                      ]
                    },
                    "value": {},
                    "reason": {
                      "type": "string"
                    },
                    "provenance": {
                      "$id": "ValueProvenance",
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "source"
                      ],
                      "properties": {
                        "source": {
                          "anyOf": [
                            {
                              "const": "repository",
                              "type": "string"
                            },
                            {
                              "const": "human-adjustment",
                              "type": "string"
                            },
                            {
                              "const": "ai-proposal",
                              "type": "string"
                            },
                            {
                              "const": "import",
                              "type": "string"
                            },
                            {
                              "const": "default",
                              "type": "string"
                            }
                          ]
                        },
                        "basedOnAiProposal": {
                          "type": "number"
                        },
                        "humanFinal": {
                          "type": "number"
                        },
                        "replayId": {
                          "type": "string"
                        },
                        "terrainPresetId": {
                          "type": "string"
                        },
                        "intent": {
                          "type": "string"
                        },
                        "at": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "destination": {
          "$id": "ClipChangeDestination",
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "character-override",
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "new-clip-versions-and-motion-set",
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "none",
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "expected": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "projectRevisionId",
        "assetReferences"
      ],
      "properties": {
        "projectRevisionId": {
          "minLength": 1,
          "type": "string"
        },
        "assetReferences": {
          "type": "array",
          "items": {
            "$id": "AssetReference",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "assetType",
              "assetId",
              "version",
              "contentHash"
            ],
            "properties": {
              "assetType": {
                "$id": "AnimationAssetType",
                "anyOf": [
                  {
                    "const": "animation-behavior",
                    "type": "string"
                  },
                  {
                    "const": "animation-motion-set",
                    "type": "string"
                  },
                  {
                    "const": "animation-clip",
                    "type": "string"
                  },
                  {
                    "const": "humanoid-rig",
                    "type": "string"
                  },
                  {
                    "const": "animation-tuning",
                    "type": "string"
                  }
                ]
              },
              "assetId": {
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "minLength": 1,
                "maxLength": 96,
                "type": "string"
              },
              "version": {
                "pattern": "^\\d+\\.\\d+\\.\\d+$",
                "type": "string"
              },
              "contentHash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "createdBy": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    }
  }
}
