{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AnimationClipDefinition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "assetPath",
    "durationSec",
    "loop",
    "rootDisplacement",
    "rootMotionMode",
    "events",
    "footContacts"
  ],
  "properties": {
    "schemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "assetPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "proceduralGenerator": {
      "type": "string"
    },
    "externalSource": {
      "$id": "ExternalAnimationSource",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "assetPath",
        "animationName"
      ],
      "properties": {
        "assetPath": {
          "minLength": 1,
          "type": "string"
        },
        "animationName": {
          "minLength": 1,
          "type": "string"
        },
        "positionScale": {
          "minimum": 0.0001,
          "maximum": 10000,
          "type": "number"
        }
      }
    },
    "durationSec": {
      "minimum": 0.01,
      "maximum": 120,
      "type": "number"
    },
    "loop": {
      "type": "boolean"
    },
    "timeCurve": {
      "$id": "ClipTimeCurve",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "properties": {
        "x1": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "y1": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "x2": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "y2": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        }
      }
    },
    "rootDisplacement": {
      "$id": "Vec3",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "rootMotionMode": {
      "$id": "RootMotionMode",
      "anyOf": [
        {
          "const": "InPlace",
          "type": "string"
        },
        {
          "const": "RootMotion",
          "type": "string"
        },
        {
          "const": "Hybrid",
          "type": "string"
        }
      ]
    },
    "rootMotionCurve": {
      "$id": "RootMotionCurve",
      "anyOf": [
        {
          "const": "Linear",
          "type": "string"
        },
        {
          "const": "FastInSlowOut",
          "type": "string"
        }
      ]
    },
    "recoveryTransitionStartNormalized": {
      "minimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "inputAcceptanceStartNormalized": {
      "minimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "rotationScaleWhilePlaying": {
      "minimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "events": {
      "type": "array",
      "items": {
        "$id": "SemanticEventDefinition",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "at"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "minLength": 1,
            "maxLength": 96,
            "type": "string"
          },
          "kind": {
            "$id": "SemanticEventKind",
            "anyOf": [
              {
                "const": "FootContactLeft",
                "type": "string"
              },
              {
                "const": "FootContactRight",
                "type": "string"
              },
              {
                "const": "AttackWindup",
                "type": "string"
              },
              {
                "const": "AttackHit",
                "type": "string"
              },
              {
                "const": "AttackRecoil",
                "type": "string"
              },
              {
                "const": "JumpTakeoff",
                "type": "string"
              },
              {
                "const": "Landing",
                "type": "string"
              },
              {
                "const": "DamageReceived",
                "type": "string"
              },
              {
                "const": "DodgeStart",
                "type": "string"
              },
              {
                "const": "DodgeEnd",
                "type": "string"
              },
              {
                "const": "GuardImpact",
                "type": "string"
              }
            ]
          },
          "at": {
            "minimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "payload": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {}
            }
          },
          "protection": {
            "$id": "ProtectionMetadata",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "level"
            ],
            "properties": {
              "level": {
                "$id": "ProtectionLevel",
                "anyOf": [
                  {
                    "const": "editable",
                    "type": "string"
                  },
                  {
                    "const": "approval-required",
                    "type": "string"
                  },
                  {
                    "const": "locked",
                    "type": "string"
                  },
                  {
                    "const": "invariant",
                    "type": "string"
                  }
                ]
              },
              "reason": {
                "type": "string"
              },
              "setBy": {
                "type": "string"
              },
              "setAt": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {
                    "$id": "ProtectionLevel",
                    "anyOf": [
                      {
                        "const": "editable",
                        "type": "string"
                      },
                      {
                        "const": "approval-required",
                        "type": "string"
                      },
                      {
                        "const": "locked",
                        "type": "string"
                      },
                      {
                        "const": "invariant",
                        "type": "string"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "footContacts": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "type": "array",
          "items": {
            "$id": "NormalizedWindow",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "end": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          }
        },
        "right": {
          "type": "array",
          "items": {
            "$id": "NormalizedWindow",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "end": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          }
        }
      }
    },
    "protection": {
      "$id": "ProtectionMetadata",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "$id": "ProtectionLevel",
          "anyOf": [
            {
              "const": "editable",
              "type": "string"
            },
            {
              "const": "approval-required",
              "type": "string"
            },
            {
              "const": "locked",
              "type": "string"
            },
            {
              "const": "invariant",
              "type": "string"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "setBy": {
          "type": "string"
        },
        "setAt": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$id": "ProtectionLevel",
              "anyOf": [
                {
                  "const": "editable",
                  "type": "string"
                },
                {
                  "const": "approval-required",
                  "type": "string"
                },
                {
                  "const": "locked",
                  "type": "string"
                },
                {
                  "const": "invariant",
                  "type": "string"
                }
              ]
            }
          }
        }
      }
    },
    "provenance": {
      "$id": "ValueProvenance",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "anyOf": [
            {
              "const": "repository",
              "type": "string"
            },
            {
              "const": "human-adjustment",
              "type": "string"
            },
            {
              "const": "ai-proposal",
              "type": "string"
            },
            {
              "const": "import",
              "type": "string"
            },
            {
              "const": "default",
              "type": "string"
            }
          ]
        },
        "basedOnAiProposal": {
          "type": "number"
        },
        "humanFinal": {
          "type": "number"
        },
        "replayId": {
          "type": "string"
        },
        "terrainPresetId": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    }
  }
}
