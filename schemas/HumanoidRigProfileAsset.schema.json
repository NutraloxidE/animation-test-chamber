{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "HumanoidRigProfileAsset",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "metadata",
    "skeleton",
    "compatibilityKey",
    "coordinateSystem",
    "humanoidBones",
    "retargetStatus"
  ],
  "properties": {
    "metadata": {
      "$id": "AnimationAssetMetadata",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "assetType",
        "id",
        "version",
        "displayName",
        "description",
        "tags",
        "createdAt",
        "createdBy",
        "contentHash"
      ],
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "assetType": {
          "$id": "AnimationAssetType",
          "anyOf": [
            {
              "const": "animation-behavior",
              "type": "string"
            },
            {
              "const": "animation-motion-set",
              "type": "string"
            },
            {
              "const": "animation-clip",
              "type": "string"
            },
            {
              "const": "humanoid-rig",
              "type": "string"
            },
            {
              "const": "animation-tuning",
              "type": "string"
            }
          ]
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "contentHash": {
          "pattern": "^([a-f0-9]{64})?$",
          "type": "string"
        },
        "protection": {
          "$id": "ProtectionMetadata",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "$id": "ProtectionLevel",
              "anyOf": [
                {
                  "const": "editable",
                  "type": "string"
                },
                {
                  "const": "approval-required",
                  "type": "string"
                },
                {
                  "const": "locked",
                  "type": "string"
                },
                {
                  "const": "invariant",
                  "type": "string"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "setBy": {
              "type": "string"
            },
            "setAt": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$id": "ProtectionLevel",
                  "anyOf": [
                    {
                      "const": "editable",
                      "type": "string"
                    },
                    {
                      "const": "approval-required",
                      "type": "string"
                    },
                    {
                      "const": "locked",
                      "type": "string"
                    },
                    {
                      "const": "invariant",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        },
        "provenance": {
          "$id": "ValueProvenance",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "anyOf": [
                {
                  "const": "repository",
                  "type": "string"
                },
                {
                  "const": "human-adjustment",
                  "type": "string"
                },
                {
                  "const": "ai-proposal",
                  "type": "string"
                },
                {
                  "const": "import",
                  "type": "string"
                },
                {
                  "const": "default",
                  "type": "string"
                }
              ]
            },
            "basedOnAiProposal": {
              "type": "number"
            },
            "humanFinal": {
              "type": "number"
            },
            "replayId": {
              "type": "string"
            },
            "terrainPresetId": {
              "type": "string"
            },
            "intent": {
              "type": "string"
            },
            "at": {
              "type": "string"
            }
          }
        },
        "assetProvenance": {
          "$id": "AssetDerivationProvenance",
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "forkedFrom": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            },
            "duplicatedFrom": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            },
            "promotedFromCandidateId": {
              "type": "string"
            },
            "migratedFromSchemaVersion": {
              "minimum": 1,
              "type": "integer"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "skeleton": {
      "$id": "SkeletonDefinition",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "height",
        "bones",
        "leftFootBone",
        "rightFootBone",
        "hipsBone"
      ],
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "height": {
          "minimum": 0.1,
          "maximum": 10,
          "type": "number"
        },
        "bones": {
          "type": "array",
          "items": {
            "$id": "SkeletonBone",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "parent",
              "restPosition"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "parent": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "humanoid": {
                "type": "string"
              },
              "restPosition": {
                "$id": "Vec3",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "leftFootBone": {
          "type": "string"
        },
        "rightFootBone": {
          "type": "string"
        },
        "hipsBone": {
          "type": "string"
        }
      }
    },
    "compatibilityKey": {
      "minLength": 1,
      "type": "string"
    },
    "coordinateSystem": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "upAxis",
        "forwardAxis",
        "handedness",
        "unitMeters"
      ],
      "properties": {
        "upAxis": {
          "const": "Y",
          "type": "string"
        },
        "forwardAxis": {
          "const": "+Z",
          "type": "string"
        },
        "handedness": {
          "const": "right",
          "type": "string"
        },
        "unitMeters": {
          "minimum": 0.0001,
          "maximum": 1000,
          "type": "number"
        }
      }
    },
    "humanoidBones": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "hips",
        "leftFoot",
        "rightFoot"
      ],
      "properties": {
        "hips": {
          "type": "string"
        },
        "spine": {
          "type": "string"
        },
        "chest": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "leftFoot": {
          "type": "string"
        },
        "rightFoot": {
          "type": "string"
        },
        "leftHand": {
          "type": "string"
        },
        "rightHand": {
          "type": "string"
        }
      }
    },
    "retargetStatus": {
      "$id": "RetargetStatus",
      "anyOf": [
        {
          "const": "direct-compatible",
          "type": "string"
        },
        {
          "const": "retarget-compatible",
          "type": "string"
        },
        {
          "const": "conversion-required",
          "type": "string"
        }
      ]
    }
  }
}
