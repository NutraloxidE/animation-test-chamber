{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AnimationSubjectDefinition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "subjectId",
    "displayName",
    "source",
    "animator",
    "presentation"
  ],
  "properties": {
    "schemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "subjectId": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "displayName": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "prefab",
        "nodeId",
        "componentId"
      ],
      "properties": {
        "prefab": {
          "$id": "GameObjectPrefabReference",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "assetType",
            "assetId",
            "version",
            "contentHash"
          ],
          "properties": {
            "assetType": {
              "$id": "GameObjectPrefabAssetType",
              "const": "game-object-prefab",
              "type": "string"
            },
            "assetId": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            },
            "version": {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            },
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        "nodeId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "componentId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        }
      }
    },
    "animator": {
      "$id": "AnimatorComponent",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "componentId",
        "componentType",
        "enabled",
        "assignment"
      ],
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "componentId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "componentType": {
          "const": "animator",
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "protection": {
          "$id": "ProtectionMetadata",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "$id": "ProtectionLevel",
              "anyOf": [
                {
                  "const": "editable",
                  "type": "string"
                },
                {
                  "const": "approval-required",
                  "type": "string"
                },
                {
                  "const": "locked",
                  "type": "string"
                },
                {
                  "const": "invariant",
                  "type": "string"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "setBy": {
              "type": "string"
            },
            "setAt": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$id": "ProtectionLevel",
                  "anyOf": [
                    {
                      "const": "editable",
                      "type": "string"
                    },
                    {
                      "const": "approval-required",
                      "type": "string"
                    },
                    {
                      "const": "locked",
                      "type": "string"
                    },
                    {
                      "const": "invariant",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        },
        "assignment": {
          "$id": "CharacterAnimationAssignment",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "behavior",
            "motionSet",
            "rig",
            "instanceOverrides"
          ],
          "properties": {
            "behavior": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            },
            "motionSet": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            },
            "rig": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            },
            "tuning": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            },
            "instanceOverrides": {
              "type": "array",
              "items": {
                "$id": "CanonicalPatch",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "path",
                  "op"
                ],
                "properties": {
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "op": {
                    "anyOf": [
                      {
                        "const": "set",
                        "type": "string"
                      },
                      {
                        "const": "append",
                        "type": "string"
                      },
                      {
                        "const": "remove",
                        "type": "string"
                      }
                    ]
                  },
                  "value": {},
                  "reason": {
                    "type": "string"
                  },
                  "provenance": {
                    "$id": "ValueProvenance",
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "source"
                    ],
                    "properties": {
                      "source": {
                        "anyOf": [
                          {
                            "const": "repository",
                            "type": "string"
                          },
                          {
                            "const": "human-adjustment",
                            "type": "string"
                          },
                          {
                            "const": "ai-proposal",
                            "type": "string"
                          },
                          {
                            "const": "import",
                            "type": "string"
                          },
                          {
                            "const": "default",
                            "type": "string"
                          }
                        ]
                      },
                      "basedOnAiProposal": {
                        "type": "number"
                      },
                      "humanFinal": {
                        "type": "number"
                      },
                      "replayId": {
                        "type": "string"
                      },
                      "terrainPresetId": {
                        "type": "string"
                      },
                      "intent": {
                        "type": "string"
                      },
                      "at": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "defaultContextKey": {
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        }
      }
    },
    "presentation": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "model": {
          "$id": "RenderableModelBinding",
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "presetId"
              ],
              "properties": {
                "kind": {
                  "const": "procedural-humanoid",
                  "type": "string"
                },
                "presetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "assetPath",
                "scale",
                "rotationYRad"
              ],
              "properties": {
                "kind": {
                  "const": "repository-model",
                  "type": "string"
                },
                "assetPath": {
                  "minLength": 1,
                  "type": "string"
                },
                "scale": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                },
                "rotationYRad": {
                  "minimum": -6.283185307179586,
                  "maximum": 6.283185307179586,
                  "type": "number"
                }
              }
            }
          ]
        },
        "capsule": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "radius",
            "height",
            "center"
          ],
          "properties": {
            "radius": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "center": {
              "$id": "Vec3",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            }
          }
        },
        "equipmentSockets": {
          "$id": "EquipmentSocketsComponent",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "schemaVersion",
            "componentId",
            "componentType",
            "enabled",
            "sockets"
          ],
          "properties": {
            "schemaVersion": {
              "minimum": 1,
              "type": "integer"
            },
            "componentId": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            },
            "componentType": {
              "const": "equipment-sockets",
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "protection": {
              "$id": "ProtectionMetadata",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "level"
              ],
              "properties": {
                "level": {
                  "$id": "ProtectionLevel",
                  "anyOf": [
                    {
                      "const": "editable",
                      "type": "string"
                    },
                    {
                      "const": "approval-required",
                      "type": "string"
                    },
                    {
                      "const": "locked",
                      "type": "string"
                    },
                    {
                      "const": "invariant",
                      "type": "string"
                    }
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "setBy": {
                  "type": "string"
                },
                "setAt": {
                  "type": "string"
                },
                "fields": {
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "$id": "ProtectionLevel",
                      "anyOf": [
                        {
                          "const": "editable",
                          "type": "string"
                        },
                        {
                          "const": "approval-required",
                          "type": "string"
                        },
                        {
                          "const": "locked",
                          "type": "string"
                        },
                        {
                          "const": "invariant",
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "sockets": {
              "type": "array",
              "items": {
                "$id": "EquipmentSocketDefinition",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "socketId",
                  "localPosition",
                  "localRotation",
                  "acceptedItemTags"
                ],
                "properties": {
                  "socketId": {
                    "pattern": "^[a-z0-9][a-z0-9-]*$",
                    "minLength": 1,
                    "maxLength": 96,
                    "type": "string"
                  },
                  "boneName": {
                    "minLength": 1,
                    "maxLength": 128,
                    "type": "string"
                  },
                  "localPosition": {
                    "type": "array",
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "localRotation": {
                    "type": "array",
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "acceptedItemTags": {
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "maxLength": 96,
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
