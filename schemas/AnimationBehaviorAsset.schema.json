{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AnimationBehaviorAsset",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "metadata",
    "derivation",
    "parameters",
    "motionSlots",
    "semanticEvents",
    "replayFixtureIds"
  ],
  "properties": {
    "metadata": {
      "$id": "AnimationAssetMetadata",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "assetType",
        "id",
        "version",
        "displayName",
        "description",
        "tags",
        "createdAt",
        "createdBy",
        "contentHash"
      ],
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "assetType": {
          "$id": "AnimationAssetType",
          "anyOf": [
            {
              "const": "animation-behavior",
              "type": "string"
            },
            {
              "const": "animation-motion-set",
              "type": "string"
            },
            {
              "const": "animation-clip",
              "type": "string"
            },
            {
              "const": "humanoid-rig",
              "type": "string"
            },
            {
              "const": "animation-tuning",
              "type": "string"
            }
          ]
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "contentHash": {
          "pattern": "^([a-f0-9]{64})?$",
          "type": "string"
        },
        "protection": {
          "$id": "ProtectionMetadata",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "$id": "ProtectionLevel",
              "anyOf": [
                {
                  "const": "editable",
                  "type": "string"
                },
                {
                  "const": "approval-required",
                  "type": "string"
                },
                {
                  "const": "locked",
                  "type": "string"
                },
                {
                  "const": "invariant",
                  "type": "string"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "setBy": {
              "type": "string"
            },
            "setAt": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$id": "ProtectionLevel",
                  "anyOf": [
                    {
                      "const": "editable",
                      "type": "string"
                    },
                    {
                      "const": "approval-required",
                      "type": "string"
                    },
                    {
                      "const": "locked",
                      "type": "string"
                    },
                    {
                      "const": "invariant",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        },
        "provenance": {
          "$id": "ValueProvenance",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "anyOf": [
                {
                  "const": "repository",
                  "type": "string"
                },
                {
                  "const": "human-adjustment",
                  "type": "string"
                },
                {
                  "const": "ai-proposal",
                  "type": "string"
                },
                {
                  "const": "import",
                  "type": "string"
                },
                {
                  "const": "default",
                  "type": "string"
                }
              ]
            },
            "basedOnAiProposal": {
              "type": "number"
            },
            "humanFinal": {
              "type": "number"
            },
            "replayId": {
              "type": "string"
            },
            "terrainPresetId": {
              "type": "string"
            },
            "intent": {
              "type": "string"
            },
            "at": {
              "type": "string"
            }
          }
        },
        "assetProvenance": {
          "$id": "AssetDerivationProvenance",
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "forkedFrom": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^([a-f0-9]{64})?$",
                  "type": "string"
                }
              }
            },
            "duplicatedFrom": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^([a-f0-9]{64})?$",
                  "type": "string"
                }
              }
            },
            "promotedFromCandidateId": {
              "type": "string"
            },
            "migratedFromSchemaVersion": {
              "minimum": 1,
              "type": "integer"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "derivation": {
      "$id": "AssetDerivation",
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "base",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "mode",
            "parent",
            "patches"
          ],
          "properties": {
            "mode": {
              "const": "variant",
              "type": "string"
            },
            "parent": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^([a-f0-9]{64})?$",
                  "type": "string"
                }
              }
            },
            "patches": {
              "type": "array",
              "items": {
                "$id": "CanonicalPatch",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "path",
                  "op"
                ],
                "properties": {
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "op": {
                    "anyOf": [
                      {
                        "const": "set",
                        "type": "string"
                      },
                      {
                        "const": "append",
                        "type": "string"
                      },
                      {
                        "const": "remove",
                        "type": "string"
                      }
                    ]
                  },
                  "value": {},
                  "reason": {
                    "type": "string"
                  },
                  "provenance": {
                    "$id": "ValueProvenance",
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "source"
                    ],
                    "properties": {
                      "source": {
                        "anyOf": [
                          {
                            "const": "repository",
                            "type": "string"
                          },
                          {
                            "const": "human-adjustment",
                            "type": "string"
                          },
                          {
                            "const": "ai-proposal",
                            "type": "string"
                          },
                          {
                            "const": "import",
                            "type": "string"
                          },
                          {
                            "const": "default",
                            "type": "string"
                          }
                        ]
                      },
                      "basedOnAiProposal": {
                        "type": "number"
                      },
                      "humanFinal": {
                        "type": "number"
                      },
                      "replayId": {
                        "type": "string"
                      },
                      "terrainPresetId": {
                        "type": "string"
                      },
                      "intent": {
                        "type": "string"
                      },
                      "at": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "mode",
            "forkedFrom",
            "forkIntent"
          ],
          "properties": {
            "mode": {
              "const": "fork",
              "type": "string"
            },
            "forkedFrom": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^([a-f0-9]{64})?$",
                  "type": "string"
                }
              }
            },
            "forkIntent": {
              "minLength": 1,
              "type": "string"
            }
          }
        }
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "$id": "AnimationParameterDefinition",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "number",
                "type": "string"
              },
              {
                "const": "boolean",
                "type": "string"
              },
              {
                "const": "string",
                "type": "string"
              },
              {
                "const": "trigger",
                "type": "string"
              }
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "motionSlots": {
      "type": "array",
      "items": {
        "$id": "MotionSlotDefinition",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "displayName",
          "required",
          "tags"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$",
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "fallbackSlot": {
            "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$",
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "expectedLoop": {
            "type": "boolean"
          },
          "expectedSemanticEvents": {
            "type": "array",
            "items": {
              "$id": "SemanticEventKind",
              "anyOf": [
                {
                  "const": "FootContactLeft",
                  "type": "string"
                },
                {
                  "const": "FootContactRight",
                  "type": "string"
                },
                {
                  "const": "AttackWindup",
                  "type": "string"
                },
                {
                  "const": "AttackHit",
                  "type": "string"
                },
                {
                  "const": "AttackRecoil",
                  "type": "string"
                },
                {
                  "const": "JumpTakeoff",
                  "type": "string"
                },
                {
                  "const": "Landing",
                  "type": "string"
                },
                {
                  "const": "DamageReceived",
                  "type": "string"
                },
                {
                  "const": "DodgeStart",
                  "type": "string"
                },
                {
                  "const": "DodgeEnd",
                  "type": "string"
                },
                {
                  "const": "GuardImpact",
                  "type": "string"
                }
              ]
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "semanticEvents": {
      "type": "array",
      "items": {
        "$id": "SemanticEventContract",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "required",
          "motionSlots"
        ],
        "properties": {
          "kind": {
            "$id": "SemanticEventKind",
            "anyOf": [
              {
                "const": "FootContactLeft",
                "type": "string"
              },
              {
                "const": "FootContactRight",
                "type": "string"
              },
              {
                "const": "AttackWindup",
                "type": "string"
              },
              {
                "const": "AttackHit",
                "type": "string"
              },
              {
                "const": "AttackRecoil",
                "type": "string"
              },
              {
                "const": "JumpTakeoff",
                "type": "string"
              },
              {
                "const": "Landing",
                "type": "string"
              },
              {
                "const": "DamageReceived",
                "type": "string"
              },
              {
                "const": "DodgeStart",
                "type": "string"
              },
              {
                "const": "DodgeEnd",
                "type": "string"
              },
              {
                "const": "GuardImpact",
                "type": "string"
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "motionSlots": {
            "type": "array",
            "items": {
              "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$",
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            }
          }
        }
      }
    },
    "graph": {
      "$id": "AnimationGraphDefinition",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "layers",
        "states",
        "transitions",
        "forcedTransitionOrder"
      ],
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "layers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$id": "LayerDefinition",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "order",
              "defaultState",
              "weight",
              "bodyMask"
            ],
            "properties": {
              "id": {
                "minLength": 1,
                "maxLength": 64,
                "type": "string"
              },
              "order": {
                "minimum": 0,
                "maximum": 8,
                "type": "integer"
              },
              "defaultState": {
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "minLength": 1,
                "maxLength": 96,
                "type": "string"
              },
              "weight": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "bodyMask": {
                "anyOf": [
                  {
                    "const": "full",
                    "type": "string"
                  },
                  {
                    "const": "upper",
                    "type": "string"
                  },
                  {
                    "const": "lower",
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "states": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$id": "StateDefinition",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "schemaVersion",
              "id",
              "motionSlot",
              "layer",
              "loop",
              "speed",
              "timeoutSec",
              "completionPolicy",
              "movementAuthorityPolicy",
              "allowReEntry",
              "interruptible"
            ],
            "properties": {
              "schemaVersion": {
                "minimum": 1,
                "type": "integer"
              },
              "id": {
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "minLength": 1,
                "maxLength": 96,
                "type": "string"
              },
              "motionSlot": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              },
              "contextualMotionSlots": {
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {
                    "type": "string"
                  }
                }
              },
              "layer": {
                "minLength": 1,
                "maxLength": 64,
                "type": "string"
              },
              "loop": {
                "type": "boolean"
              },
              "speed": {
                "minimum": 0.05,
                "maximum": 4,
                "type": "number"
              },
              "timeoutSec": {
                "minimum": 0,
                "maximum": 60,
                "type": "number"
              },
              "fallbackState": {
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "minLength": 1,
                "maxLength": 96,
                "type": "string"
              },
              "completionPolicy": {
                "$id": "StateCompletionPolicy",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "mode",
                  "holdTicks"
                ],
                "properties": {
                  "mode": {
                    "anyOf": [
                      {
                        "const": "loop",
                        "type": "string"
                      },
                      {
                        "const": "immediate-fallback",
                        "type": "string"
                      },
                      {
                        "const": "hold-final-frame",
                        "type": "string"
                      },
                      {
                        "const": "wait-for-transition",
                        "type": "string"
                      }
                    ]
                  },
                  "holdTicks": {
                    "minimum": 0,
                    "maximum": 240,
                    "type": "integer"
                  }
                }
              },
              "recoveryPolicy": {
                "$id": "StateRecoveryPolicy",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "authorityReturnAtNormalized",
                  "blendDurationSec"
                ],
                "properties": {
                  "authorityReturnAtNormalized": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  },
                  "blendDurationSec": {
                    "minimum": 0,
                    "maximum": 2,
                    "type": "number"
                  }
                }
              },
              "movementAuthorityPolicy": {
                "$id": "MovementAuthorityPolicy",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "locksMovementUntilRecovery",
                  "returnsAuthorityOnRecovery",
                  "providesLocomotionAuthority",
                  "locomotionSpeedReference"
                ],
                "properties": {
                  "locksMovementUntilRecovery": {
                    "type": "boolean"
                  },
                  "returnsAuthorityOnRecovery": {
                    "type": "boolean"
                  },
                  "providesLocomotionAuthority": {
                    "type": "boolean"
                  },
                  "locomotionSpeedReference": {
                    "anyOf": [
                      {
                        "const": "none",
                        "type": "string"
                      },
                      {
                        "const": "walk",
                        "type": "string"
                      },
                      {
                        "const": "run",
                        "type": "string"
                      }
                    ]
                  }
                }
              },
              "allowReEntry": {
                "type": "boolean"
              },
              "interruptible": {
                "type": "boolean"
              },
              "bodyMask": {
                "anyOf": [
                  {
                    "const": "full",
                    "type": "string"
                  },
                  {
                    "const": "upper",
                    "type": "string"
                  },
                  {
                    "const": "lower",
                    "type": "string"
                  }
                ]
              },
              "protection": {
                "$id": "ProtectionMetadata",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "level"
                ],
                "properties": {
                  "level": {
                    "$id": "ProtectionLevel",
                    "anyOf": [
                      {
                        "const": "editable",
                        "type": "string"
                      },
                      {
                        "const": "approval-required",
                        "type": "string"
                      },
                      {
                        "const": "locked",
                        "type": "string"
                      },
                      {
                        "const": "invariant",
                        "type": "string"
                      }
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "setBy": {
                    "type": "string"
                  },
                  "setAt": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "patternProperties": {
