{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "GameObjectInstanceDefinition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "enabled",
    "prefab",
    "transform",
    "componentOverrides",
    "bindings",
    "relations"
  ],
  "properties": {
    "schemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "prefab": {
      "$id": "GameObjectPrefabReference",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "assetType",
        "assetId",
        "version",
        "contentHash"
      ],
      "properties": {
        "assetType": {
          "$id": "GameObjectPrefabAssetType",
          "const": "game-object-prefab",
          "type": "string"
        },
        "assetId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        "contentHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      }
    },
    "transform": {
      "$id": "TransformDefinition",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "minimum": -10000,
              "maximum": 10000,
              "type": "number"
            },
            "y": {
              "minimum": -10000,
              "maximum": 10000,
              "type": "number"
            },
            "z": {
              "minimum": -10000,
              "maximum": 10000,
              "type": "number"
            }
          }
        },
        "rotation": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "w"
          ],
          "properties": {
            "x": {
              "minimum": -1,
              "maximum": 1,
              "type": "number"
            },
            "y": {
              "minimum": -1,
              "maximum": 1,
              "type": "number"
            },
            "z": {
              "minimum": -1,
              "maximum": 1,
              "type": "number"
            },
            "w": {
              "minimum": -1,
              "maximum": 1,
              "type": "number"
            }
          }
        },
        "scale": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "minimum": 0.001,
              "maximum": 1000,
              "type": "number"
            },
            "y": {
              "minimum": 0.001,
              "maximum": 1000,
              "type": "number"
            },
            "z": {
              "minimum": 0.001,
              "maximum": 1000,
              "type": "number"
            }
          }
        }
      }
    },
    "componentOverrides": {
      "type": "array",
      "items": {
        "$id": "PrefabComponentOverride",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodeId",
          "componentId",
          "patches"
        ],
        "properties": {
          "nodeId": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "minLength": 1,
            "maxLength": 96,
            "type": "string"
          },
          "componentId": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "minLength": 1,
            "maxLength": 96,
            "type": "string"
          },
          "patches": {
            "type": "array",
            "items": {
              "$id": "CanonicalPatch",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "path",
                "op"
              ],
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "op": {
                  "anyOf": [
                    {
                      "const": "set",
                      "type": "string"
                    },
                    {
                      "const": "append",
                      "type": "string"
                    },
                    {
                      "const": "remove",
                      "type": "string"
                    }
                  ]
                },
                "value": {},
                "reason": {
                  "type": "string"
                },
                "provenance": {
                  "$id": "ValueProvenance",
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "source"
                  ],
                  "properties": {
                    "source": {
                      "anyOf": [
                        {
                          "const": "repository",
                          "type": "string"
                        },
                        {
                          "const": "human-adjustment",
                          "type": "string"
                        },
                        {
                          "const": "ai-proposal",
                          "type": "string"
                        },
                        {
                          "const": "import",
                          "type": "string"
                        },
                        {
                          "const": "default",
                          "type": "string"
                        }
                      ]
                    },
                    "basedOnAiProposal": {
                      "type": "number"
                    },
                    "humanFinal": {
                      "type": "number"
                    },
                    "replayId": {
                      "type": "string"
                    },
                    "terrainPresetId": {
                      "type": "string"
                    },
                    "intent": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "bindings": {
      "$id": "GameObjectInstanceBindings",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "characterIntent": {
          "$id": "CharacterControllerBindingDefinition",
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "playerIndex"
              ],
              "properties": {
                "kind": {
                  "const": "human",
                  "type": "string"
                },
                "playerIndex": {
                  "minimum": 0,
                  "maximum": 7,
                  "type": "integer"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "trackId"
              ],
              "properties": {
                "kind": {
                  "const": "script",
                  "type": "string"
                },
                "trackId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "channelId"
              ],
              "properties": {
                "kind": {
                  "const": "ai",
                  "type": "string"
                },
                "channelId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "replayId"
              ],
              "properties": {
                "kind": {
                  "const": "replay",
                  "type": "string"
                },
                "replayId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "none",
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "relations": {
      "$id": "GameObjectInstanceRelations",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "cameraTargetGameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        }
      }
    },
    "protection": {
      "$id": "ProtectionMetadata",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "$id": "ProtectionLevel",
          "anyOf": [
            {
              "const": "editable",
              "type": "string"
            },
            {
              "const": "approval-required",
              "type": "string"
            },
            {
              "const": "locked",
              "type": "string"
            },
            {
              "const": "invariant",
              "type": "string"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "setBy": {
          "type": "string"
        },
        "setAt": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$id": "ProtectionLevel",
              "anyOf": [
                {
                  "const": "editable",
                  "type": "string"
                },
                {
                  "const": "approval-required",
                  "type": "string"
                },
                {
                  "const": "locked",
                  "type": "string"
                },
                {
                  "const": "invariant",
                  "type": "string"
                }
              ]
            }
          }
        }
      }
    }
  }
}
