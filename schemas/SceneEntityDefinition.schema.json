              "properties": {
                "kind": {
                  "const": "human",
                  "type": "string"
                },
                "playerIndex": {
                  "minimum": 0,
                  "maximum": 7,
                  "type": "integer"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "trackId"
              ],
              "properties": {
                "kind": {
                  "const": "script",
                  "type": "string"
                },
                "trackId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "channelId"
              ],
              "properties": {
                "kind": {
                  "const": "ai",
