                },
                "replayId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "none",
                  "type": "string"
                }
              }
            }
          ]
