                "x": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "y": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "z": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "w": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                }
              }
            },
            "scale": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                },
                "y": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                },
                "z": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                }
              }
            }
          }
        },
        "protection": {
          "$id": "ProtectionMetadata",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "$id": "ProtectionLevel",
              "anyOf": [
                {
                  "const": "editable",
                  "type": "string"
                },
                {
                  "const": "approval-required",
                  "type": "string"
                },
                {
                  "const": "locked",
                  "type": "string"
                },
                {
                  "const": "invariant",
                  "type": "string"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "setBy": {
              "type": "string"
            },
            "setAt": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$id": "ProtectionLevel",
