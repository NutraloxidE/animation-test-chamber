{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SceneEntityDefinition",
  "anyOf": [
    {
      "$id": "CharacterSceneEntity",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "displayName",
        "enabled",
        "transform",
        "kind",
        "characterId",
        "controller"
      ],
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "transform": {
          "$id": "TransformDefinition",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "position",
            "rotation",
            "scale"
          ],
          "properties": {
            "position": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                },
                "y": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                },
                "z": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                }
              }
            },
            "rotation": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z",
                "w"
