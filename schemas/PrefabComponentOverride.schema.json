{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "PrefabComponentOverride",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "nodeId",
    "componentId",
    "patches"
  ],
  "properties": {
    "nodeId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "componentId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "patches": {
      "type": "array",
      "items": {
        "$id": "CanonicalPatch",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "op"
        ],
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "op": {
            "anyOf": [
              {
                "const": "set",
                "type": "string"
              },
              {
                "const": "append",
                "type": "string"
              },
              {
                "const": "remove",
                "type": "string"
              }
            ]
          },
          "value": {},
          "reason": {
            "type": "string"
          },
          "provenance": {
            "$id": "ValueProvenance",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "anyOf": [
                  {
                    "const": "repository",
                    "type": "string"
                  },
                  {
                    "const": "human-adjustment",
                    "type": "string"
                  },
                  {
                    "const": "ai-proposal",
                    "type": "string"
                  },
                  {
                    "const": "import",
                    "type": "string"
                  },
                  {
                    "const": "default",
                    "type": "string"
                  }
                ]
              },
              "basedOnAiProposal": {
                "type": "number"
              },
              "humanFinal": {
                "type": "number"
              },
              "replayId": {
                "type": "string"
              },
              "terrainPresetId": {
                "type": "string"
              },
              "intent": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
