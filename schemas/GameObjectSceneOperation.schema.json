{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "GameObjectSceneOperation",
  "anyOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "displayName",
        "prefab"
      ],
      "properties": {
        "type": {
          "const": "scene.place_prefab",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "displayName": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        "prefab": {
          "$id": "GameObjectPrefabReference",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "assetType",
            "assetId",
            "version",
            "contentHash"
          ],
          "properties": {
            "assetType": {
              "$id": "GameObjectPrefabAssetType",
              "const": "game-object-prefab",
              "type": "string"
            },
            "assetId": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            },
            "version": {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            },
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        "transform": {
          "$id": "TransformDefinition",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "position",
            "rotation",
            "scale"
          ],
          "properties": {
            "position": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                },
                "y": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                },
                "z": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                }
              }
            },
            "rotation": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z",
                "w"
              ],
              "properties": {
                "x": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "y": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "z": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "w": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                }
              }
            },
            "scale": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                },
                "y": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                },
                "z": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId"
      ],
      "properties": {
        "type": {
          "const": "scene.delete_game_object",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId"
      ],
      "properties": {
        "type": {
          "const": "scene.duplicate_game_object",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "displayName"
      ],
      "properties": {
        "type": {
          "const": "scene.rename_game_object",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "displayName": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "transform"
      ],
      "properties": {
        "type": {
          "const": "scene.set_transform",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "transform": {
          "$id": "TransformDefinition",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "position",
            "rotation",
            "scale"
          ],
          "properties": {
            "position": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                },
                "y": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                },
                "z": {
                  "minimum": -10000,
                  "maximum": 10000,
                  "type": "number"
                }
              }
            },
            "rotation": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z",
                "w"
              ],
              "properties": {
                "x": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "y": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "z": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                },
                "w": {
                  "minimum": -1,
                  "maximum": 1,
                  "type": "number"
                }
              }
            },
            "scale": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                },
                "y": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                },
                "z": {
                  "minimum": 0.001,
                  "maximum": 1000,
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "enabled"
      ],
      "properties": {
        "type": {
          "const": "scene.set_enabled",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "prefab"
      ],
      "properties": {
        "type": {
          "const": "scene.set_prefab_source",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "prefab": {
          "$id": "GameObjectPrefabReference",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "assetType",
            "assetId",
            "version",
            "contentHash"
          ],
          "properties": {
            "assetType": {
              "$id": "GameObjectPrefabAssetType",
              "const": "game-object-prefab",
              "type": "string"
            },
            "assetId": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            },
            "version": {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            },
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "override"
      ],
      "properties": {
        "type": {
          "const": "scene.set_component_override",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "override": {
          "$id": "PrefabComponentOverride",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "nodeId",
            "componentId",
            "patches"
          ],
          "properties": {
            "nodeId": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            },
            "componentId": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            },
            "patches": {
              "type": "array",
              "items": {
                "$id": "CanonicalPatch",
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "path",
                  "op"
                ],
                "properties": {
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "op": {
                    "anyOf": [
                      {
                        "const": "set",
                        "type": "string"
                      },
                      {
                        "const": "append",
                        "type": "string"
                      },
                      {
                        "const": "remove",
                        "type": "string"
                      }
                    ]
                  },
                  "value": {},
                  "reason": {
                    "type": "string"
                  },
                  "provenance": {
                    "$id": "ValueProvenance",
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "source"
                    ],
                    "properties": {
                      "source": {
                        "anyOf": [
                          {
                            "const": "repository",
                            "type": "string"
                          },
                          {
                            "const": "human-adjustment",
                            "type": "string"
                          },
                          {
                            "const": "ai-proposal",
                            "type": "string"
                          },
                          {
                            "const": "import",
                            "type": "string"
                          },
                          {
                            "const": "default",
                            "type": "string"
                          }
                        ]
                      },
                      "basedOnAiProposal": {
                        "type": "number"
                      },
                      "humanFinal": {
                        "type": "number"
                      },
                      "replayId": {
                        "type": "string"
                      },
                      "terrainPresetId": {
                        "type": "string"
                      },
                      "intent": {
                        "type": "string"
                      },
                      "at": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "nodeId",
        "componentId"
      ],
      "properties": {
        "type": {
          "const": "scene.clear_component_override",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "nodeId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "componentId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "bindings"
      ],
      "properties": {
        "type": {
          "const": "scene.set_instance_binding",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "bindings": {
          "$id": "GameObjectInstanceBindings",
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "characterIntent": {
              "$id": "CharacterControllerBindingDefinition",
              "anyOf": [
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "playerIndex"
                  ],
                  "properties": {
                    "kind": {
                      "const": "human",
                      "type": "string"
                    },
                    "playerIndex": {
                      "minimum": 0,
                      "maximum": 7,
                      "type": "integer"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "trackId"
                  ],
                  "properties": {
                    "kind": {
                      "const": "script",
                      "type": "string"
                    },
                    "trackId": {
                      "pattern": "^[a-z0-9][a-z0-9-]*$",
                      "minLength": 1,
                      "maxLength": 96,
                      "type": "string"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "channelId"
                  ],
                  "properties": {
                    "kind": {
                      "const": "ai",
                      "type": "string"
                    },
                    "channelId": {
                      "pattern": "^[a-z0-9][a-z0-9-]*$",
                      "minLength": 1,
                      "maxLength": 96,
                      "type": "string"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "replayId"
                  ],
                  "properties": {
                    "kind": {
                      "const": "replay",
                      "type": "string"
                    },
                    "replayId": {
                      "pattern": "^[a-z0-9][a-z0-9-]*$",
                      "minLength": 1,
                      "maxLength": 96,
                      "type": "string"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "none",
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "relations"
      ],
      "properties": {
        "type": {
          "const": "scene.set_relation",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "relations": {
          "$id": "GameObjectInstanceRelations",
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "cameraTargetGameObjectId": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId",
        "toIndex"
      ],
      "properties": {
        "type": {
          "const": "scene.reorder_game_object",
          "type": "string"
        },
        "gameObjectId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "toIndex": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "gameObjectId"
      ],
      "properties": {
        "type": {
          "const": "scene.set_active_camera",
          "type": "string"
        },
        "gameObjectId": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  ]
}
