{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AnimationTuningProfileAsset",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "metadata",
    "compatibleBehavior",
    "patches"
  ],
  "properties": {
    "metadata": {
      "$id": "AnimationAssetMetadata",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "assetType",
        "id",
        "version",
        "displayName",
        "description",
        "tags",
        "createdAt",
        "createdBy",
        "contentHash"
      ],
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "assetType": {
          "$id": "AnimationAssetType",
          "anyOf": [
            {
              "const": "animation-behavior",
              "type": "string"
            },
            {
              "const": "animation-motion-set",
              "type": "string"
            },
            {
              "const": "animation-clip",
              "type": "string"
            },
            {
              "const": "humanoid-rig",
              "type": "string"
            },
            {
              "const": "animation-tuning",
              "type": "string"
            }
          ]
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "contentHash": {
          "pattern": "^([a-f0-9]{64})?$",
          "type": "string"
        },
        "protection": {
          "$id": "ProtectionMetadata",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "$id": "ProtectionLevel",
              "anyOf": [
                {
                  "const": "editable",
                  "type": "string"
                },
                {
                  "const": "approval-required",
                  "type": "string"
                },
                {
                  "const": "locked",
                  "type": "string"
                },
                {
                  "const": "invariant",
                  "type": "string"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "setBy": {
              "type": "string"
            },
            "setAt": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$id": "ProtectionLevel",
                  "anyOf": [
                    {
                      "const": "editable",
                      "type": "string"
                    },
                    {
                      "const": "approval-required",
                      "type": "string"
                    },
                    {
                      "const": "locked",
                      "type": "string"
                    },
                    {
                      "const": "invariant",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        },
        "provenance": {
          "$id": "ValueProvenance",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "anyOf": [
                {
                  "const": "repository",
                  "type": "string"
                },
                {
                  "const": "human-adjustment",
                  "type": "string"
                },
                {
                  "const": "ai-proposal",
                  "type": "string"
                },
                {
                  "const": "import",
                  "type": "string"
                },
                {
                  "const": "default",
                  "type": "string"
                }
              ]
            },
            "basedOnAiProposal": {
              "type": "number"
            },
            "humanFinal": {
              "type": "number"
            },
            "replayId": {
              "type": "string"
            },
            "terrainPresetId": {
              "type": "string"
            },
            "intent": {
              "type": "string"
            },
            "at": {
              "type": "string"
            }
          }
        },
        "assetProvenance": {
          "$id": "AssetDerivationProvenance",
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "forkedFrom": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^([a-f0-9]{64})?$",
                  "type": "string"
                }
              }
            },
            "duplicatedFrom": {
              "$id": "AssetReference",
              "additionalProperties": false,
              "type": "object",
              "required": [
                "assetType",
                "assetId",
                "version",
                "contentHash"
              ],
              "properties": {
                "assetType": {
                  "$id": "AnimationAssetType",
                  "anyOf": [
                    {
                      "const": "animation-behavior",
                      "type": "string"
                    },
                    {
                      "const": "animation-motion-set",
                      "type": "string"
                    },
                    {
                      "const": "animation-clip",
                      "type": "string"
                    },
                    {
                      "const": "humanoid-rig",
                      "type": "string"
                    },
                    {
                      "const": "animation-tuning",
                      "type": "string"
                    }
                  ]
                },
                "assetId": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "minLength": 1,
                  "maxLength": 96,
                  "type": "string"
                },
                "version": {
                  "pattern": "^\\d+\\.\\d+\\.\\d+$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^([a-f0-9]{64})?$",
                  "type": "string"
                }
              }
            },
            "promotedFromCandidateId": {
              "type": "string"
            },
            "migratedFromSchemaVersion": {
              "minimum": 1,
              "type": "integer"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "compatibleBehavior": {
      "$id": "AssetReference",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "assetType",
        "assetId",
        "version",
        "contentHash"
      ],
      "properties": {
        "assetType": {
          "$id": "AnimationAssetType",
          "anyOf": [
            {
              "const": "animation-behavior",
              "type": "string"
            },
            {
              "const": "animation-motion-set",
              "type": "string"
            },
            {
              "const": "animation-clip",
              "type": "string"
            },
            {
              "const": "humanoid-rig",
              "type": "string"
            },
            {
              "const": "animation-tuning",
              "type": "string"
            }
          ]
        },
        "assetId": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 96,
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        "contentHash": {
          "pattern": "^([a-f0-9]{64})?$",
          "type": "string"
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$id": "CanonicalPatch",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "op"
        ],
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "op": {
            "anyOf": [
              {
                "const": "set",
                "type": "string"
              },
              {
                "const": "append",
                "type": "string"
              },
              {
                "const": "remove",
                "type": "string"
              }
            ]
          },
          "value": {},
          "reason": {
            "type": "string"
          },
          "provenance": {
            "$id": "ValueProvenance",
            "additionalProperties": false,
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "anyOf": [
                  {
                    "const": "repository",
                    "type": "string"
                  },
                  {
                    "const": "human-adjustment",
                    "type": "string"
                  },
                  {
                    "const": "ai-proposal",
                    "type": "string"
                  },
                  {
                    "const": "import",
                    "type": "string"
                  },
                  {
                    "const": "default",
                    "type": "string"
                  }
                ]
              },
              "basedOnAiProposal": {
                "type": "number"
              },
              "humanFinal": {
                "type": "number"
              },
              "replayId": {
                "type": "string"
              },
              "terrainPresetId": {
                "type": "string"
              },
              "intent": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
