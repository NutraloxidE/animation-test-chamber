{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ProtectionApproval",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "approvedPaths",
    "reason"
  ],
  "properties": {
    "approvedPaths": {
      "uniqueItems": true,
      "maxItems": 256,
      "type": "array",
      "items": {
        "pattern": "^/",
        "minLength": 1,
        "maxLength": 512,
        "type": "string"
      }
    },
    "reason": {
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "type": "string"
    }
  }
}
