{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "PropSceneEntity",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "enabled",
    "transform",
    "kind",
    "asset"
  ],
  "properties": {
    "schemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 96,
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "transform": {
      "$id": "TransformDefinition",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "minimum": -10000,
              "maximum": 10000,
              "type": "number"
            },
            "y": {
              "minimum": -10000,
              "maximum": 10000,
              "type": "number"
            },
            "z": {
              "minimum": -10000,
              "maximum": 10000,
              "type": "number"
            }
          }
        },
        "rotation": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "w"
          ],
          "properties": {
            "x": {
              "minimum": -1,
              "maximum": 1,
              "type": "number"
            },
            "y": {
              "minimum": -1,
              "maximum": 1,
              "type": "number"
            },
            "z": {
              "minimum": -1,
              "maximum": 1,
              "type": "number"
            },
            "w": {
              "minimum": -1,
              "maximum": 1,
              "type": "number"
            }
          }
        },
        "scale": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "minimum": 0.001,
              "maximum": 1000,
              "type": "number"
            },
            "y": {
              "minimum": 0.001,
              "maximum": 1000,
              "type": "number"
            },
            "z": {
              "minimum": 0.001,
              "maximum": 1000,
              "type": "number"
            }
          }
        }
      }
    },
    "protection": {
      "$id": "ProtectionMetadata",
      "additionalProperties": false,
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "$id": "ProtectionLevel",
          "anyOf": [
            {
              "const": "editable",
              "type": "string"
            },
            {
              "const": "approval-required",
              "type": "string"
            },
            {
              "const": "locked",
              "type": "string"
            },
            {
              "const": "invariant",
              "type": "string"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "setBy": {
          "type": "string"
        },
        "setAt": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$id": "ProtectionLevel",
              "anyOf": [
                {
                  "const": "editable",
                  "type": "string"
                },
                {
                  "const": "approval-required",
                  "type": "string"
                },
                {
                  "const": "locked",
                  "type": "string"
                },
                {
                  "const": "invariant",
                  "type": "string"
                }
              ]
            }
          }
        }
      }
    },
    "kind": {
      "const": "prop",
      "type": "string"
    },
    "asset": {
      "$id": "SceneAssetReference",
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "assetPath"
          ],
          "properties": {
            "kind": {
              "const": "model",
              "type": "string"
            },
            "assetPath": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "assetId"
          ],
          "properties": {
            "kind": {
              "const": "asset",
              "type": "string"
            },
            "assetId": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1,
              "maxLength": 96,
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "maxLength": 32,
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
